const leaving = appBySlug('recart')!;
const path = '/alternatives/recart-alternative';
const title = `Best ${leaving.name} Alternatives for Shopify SMS Marketing (2026)`;
const desc = 'Why Shopify merchants leave Recart for campaign calendar fit — drop orchestration, offer discipline, segment-by-value.';

const faqs = [
  { question: 'Why leave Recart for campaign marketing?', answer: 'Stores outgrow recovery-only tooling when VIP drops, launches, or replenishment need governed campaign mechanics. Sauce Lab restraint (one launch plus one scarcity text) runs on full campaign platforms; recovery specialists cannot fake drop orchestration. Leave when promotional needs exceed recovery mechanics.' },
  { question: 'Best Recart alternative for SMS campaigns?', answer: 'Postscript #1 for lean DTC SMS execution, Attentive #2 at enterprise scale, Sequenzy #3 as the lifecycle email layer. For email-side depth without SMS ambition, Klaviyo (data) or Omnisend (multichannel speed) depending on team sophistication.' },
  { question: 'Does Sequenzy replace Recart SMS?', answer: 'Sequenzy is the email layer — welcome depth, education, winback at $19/month. Pair with Postscript or Attentive for promotional SMS. Recart-plus-Sequenzy works during the starting phase; graduate recovery-only to full-calendar tooling when promotional needs arrive.' },
  { question: 'How do costs compare leaving Recart?', answer: 'Recovery economics look cheap until promotional needs demand a second platform; Postscript-plus-Sequenzy often costs similar to Recart-plus-workarounds with far deeper capability. Model recovery revenue against full-calendar potential, not platform fees alone.' },
  { question: 'When should a store keep Recart?', answer: 'For mobile-first cart recovery (Messenger plus SMS) at small scale where promotional calendars stay minimal. Keep it as a complement with measured incrementality, never as the campaign backbone once drops and VIP logic matter.' },
  { question: 'What migrates first?', answer: 'SMS urgency (highest revenue impact, clearest specialist gap), then lifecycle email depth, then bulk campaigns last. Staged migration protects deliverability and gives each layer time to prove revenue before the next moves.' },
];
